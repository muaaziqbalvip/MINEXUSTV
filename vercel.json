{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/movie/:id*", "destination": "/index.html" },
    { "source": "/series/:id*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
