{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          "watchCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "leaderboard": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "displayName": { ".validate": "newData.isString()" },
        "watchCount": { ".validate": "newData.isNumber() && newData.val() >= 0" }
      }
    },
    ".read": false,
    ".write": false
  }
}
